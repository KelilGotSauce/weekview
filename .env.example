# Notion — server only
NOTION_API_KEY=secret_your_notion_integration_secret
NOTION_DATABASE_ID=your_32_character_database_id

# Google OAuth — use the same Google Cloud OAuth Web Client as the old Calendar app.
# Add http://localhost:8787/api/auth/google/callback to Authorized redirect URIs.
GOOGLE_CLIENT_ID=your_google_web_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_web_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
APP_ORIGIN=http://localhost:5173

# Generate a long random value for signing the persistent session cookie.
SESSION_SECRET=replace_with_a_long_random_secret
PORT=8787
